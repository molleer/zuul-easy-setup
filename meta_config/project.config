[access]
	inheritFrom = All-Projects
[submit]
	action = inherit
[label "Verified"]
  function = NoOp
  value = -2 Gate failed
  value = -1 Check failed
  value = 0 Change to be verified
  value = +1 Check passed
  value = +2 Gate passed
	defaultValue = 0
[access "refs/*"]
	label-Verified = -2..+2 group Administrators
	label-Verified = -2..+2 group Service Users
	submit = group Administrators
	submit = group Service Users
[submit-requirement "Verified"]
	description = Change verified by Zuul
	applicableIf = -branch:refs/meta/config
	submittableIf = label:Verified=MAX AND -label:Verified=MIN AND Code-Review=MAX
	canOverrideInChildProjects = false
